# ─── Master ───────────────────────────────────────────────
MASTER_HTTP_PORT=8000
SCHEDULING_STRATEGY=load_aware   # round_robin | least_active | load_aware | lowest_latency
MAX_RETRIES=3
TASK_TIMEOUT=120                  # seconds before a task is considered timed out
HEARTBEAT_TIMEOUT=6               # seconds of missed heartbeat before marking unhealthy
HEALTH_CHECK_INTERVAL=1           # seconds between master heartbeat timeout checks
MAX_QUEUE_SIZE=5000               # max queued tasks before rejecting new requests
RAG_ENABLED=true
RAG_TOP_K=3
RAG_DOCS_DIR=rag/knowledge_base
RAG_DB_DIR=.chroma
MASTER_HEALTHCHECK_INTERVAL=10s
MASTER_HEALTHCHECK_TIMEOUT=5s
MASTER_HEALTHCHECK_RETRIES=3

# ─── Monitoring ───────────────────────────────────────────
PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_PORT=3000
GF_SERVER_HTTP_PORT=3000
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_SECURITY_ADMIN_PASSWORD=admin

# ─── Worker ───────────────────────────────────────────────
MASTER_HTTP_URL=http://192.168.1.10:8000  # Master LAN IP:HTTP port
OLLAMA_URL=http://host.docker.internal:11434  # use http://localhost:11434 on Linux --network=host
WORKER_MODEL=llama3.2:1b
HEARTBEAT_INTERVAL=2              # seconds between heartbeats
WORKER_HTTP_PORT=8001             # Prometheus metrics and inference HTTP port
WORKER_ADVERTISE_HOST=              # Worker LAN IP/hostname reachable by Master
