# ─── Master ───────────────────────────────────────────────
MASTER_HTTP_PORT=8000
MASTER_GRPC_PORT=50051
SCHEDULING_STRATEGY=load_aware   # round_robin | least_active | load_aware | lowest_latency
MAX_RETRIES=3
TASK_TIMEOUT=120                  # seconds before a task is considered timed out
HEARTBEAT_TIMEOUT=15              # seconds of missed heartbeat before marking unhealthy
MAX_QUEUE_SIZE=5000               # max queued tasks before rejecting new requests

# ─── Worker ───────────────────────────────────────────────
MASTER_GRPC_URL=192.168.1.10:50051   # Master LAN IP:gRPC port
OLLAMA_URL=http://host.docker.internal:11434  # use http://localhost:11434 on Linux --network=host
WORKER_MODEL=llama3.2:1b
WORKER_MAX_CONCURRENT=4           # max simultaneous Ollama generations
HEARTBEAT_INTERVAL=5              # seconds between heartbeats
WORKER_HTTP_PORT=8001             # Prometheus metrics HTTP port
WORKER_GRPC_PORT=50052            # gRPC server port (Master calls here)
