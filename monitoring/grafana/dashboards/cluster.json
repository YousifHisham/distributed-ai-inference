{
  "title": "Distributed AI Inference Cluster",
  "uid": "dist-ai-cluster",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Healthy Workers",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"red","value":0},{"color":"yellow","value":1},{"color":"green","value":2}] } }
      },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(worker_status == 1)", "legendFormat": "Healthy" }]
    },
    {
      "id": 2, "type": "stat", "title": "Draining Workers",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"green","value":0},{"color":"orange","value":1}] } }
      },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(worker_status == 0.5)", "legendFormat": "Draining" }]
    },
    {
      "id": 3, "type": "stat", "title": "Unhealthy Workers",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"green","value":0},{"color":"red","value":1}] } }
      },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(worker_status == 0)", "legendFormat": "Unhealthy" }]
    },
    {
      "id": 4, "type": "stat", "title": "Requests/sec",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(rate(inference_requests_total[1m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 5, "type": "stat", "title": "Success Rate",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"red","value":0},{"color":"yellow","value":0.9},{"color":"green","value":0.99}] } }
      },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(rate(inference_requests_total{status='success'}[1m])) / sum(rate(inference_requests_total[1m]))", "legendFormat": "Success %" }]
    },
    {
      "id": 6, "type": "stat", "title": "Error Requests (5m)",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"green","value":0},{"color":"orange","value":1},{"color":"red","value":10}] } }
      },
      "targets": [{ "datasource": "Prometheus", "expr": "increase(inference_requests_total{status='error'}[5m])", "legendFormat": "Errors (5m)" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Throughput (requests/sec) by Strategy",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "datasource": "Prometheus", "expr": "sum by (strategy) (rate(inference_requests_total{status='success'}[30s]))", "legendFormat": "{{strategy}}" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Inference Latency Percentiles",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.50, sum by (le) (rate(inference_latency_seconds_bucket[1m])))", "legendFormat": "p50" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, sum by (le) (rate(inference_latency_seconds_bucket[1m])))", "legendFormat": "p95" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.99, sum by (le) (rate(inference_latency_seconds_bucket[1m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Per-Worker GPU Utilization %",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        { "datasource": "Prometheus", "expr": "worker_gpu_util_pct", "legendFormat": "{{worker_id}}" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Per-Worker VRAM Used (GB)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "decgbytes" } },
      "targets": [
        { "datasource": "Prometheus", "expr": "worker_vram_used_gb", "legendFormat": "{{worker_id}}" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Per-Worker GPU Temperature (°C)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "celsius", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":75},{"color":"red","value":85}] } }
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "worker_gpu_temp_c", "legendFormat": "{{worker_id}}" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Per-Worker Active Requests",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "datasource": "Prometheus", "expr": "worker_active_requests", "legendFormat": "{{worker_id}}" }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Latency by Strategy (p95)",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, sum by (strategy, le) (rate(inference_latency_seconds_bucket[2m])))", "legendFormat": "p95 {{strategy}}" }
      ]
    },
    {
      "id": 14, "type": "table", "title": "Worker Status Overview",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "datasource": "Prometheus", "expr": "worker_active_requests", "legendFormat": "Active Requests", "instant": true },
        { "datasource": "Prometheus", "expr": "worker_gpu_util_pct", "legendFormat": "GPU %", "instant": true },
        { "datasource": "Prometheus", "expr": "worker_gpu_temp_c", "legendFormat": "Temp °C", "instant": true },
        { "datasource": "Prometheus", "expr": "worker_status", "legendFormat": "Status", "instant": true }
      ]
    }
  ]
}
