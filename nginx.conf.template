limit_req_zone $binary_remote_addr zone=infer_limit:10m rate=100r/s;

upstream master_backend {
    server master:${MASTER_HTTP_PORT} max_fails=3 fail_timeout=10s;
    keepalive 64;
}

server {
    listen 80;

    location /infer {
        limit_req zone=infer_limit burst=200 nodelay;
        limit_req_status 503;

        proxy_pass http://master_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;

        # Return 503 on queue full (limit_req exceeded)
        error_page 503 = @queue_full;
    }

    location @queue_full {
        return 503 '{"detail":"queue full — try again later"}';
        add_header Content-Type application/json;
    }

    location / {
        proxy_pass http://master_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
}
